SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Django admin clock vs your PC: use your IANA timezone (defaults in settings to Europe/Berlin if unset).
# TIME_ZONE=Europe/Athens

# Local dev without Supabase works out of the box:
DATABASE_URL=sqlite:///db.sqlite3

# For offline/unit tests when your machine has DATABASE_URL pointing at Postgres:
# USE_SQLITE=1

# Supabase Postgres connection string examples (copy from Supabase Dashboard):
#
# Prefer the pooler/IPv4-compatible connection URI if direct `db.` host fails on your network/WSL setup.
#
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Or direct Postgres:
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require